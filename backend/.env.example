# URL de conexión asíncrona a la base de datos PostgreSQL (Motor asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/activos_fijos

# Ruta de exportación física del archivo JSON consumido por el Dashboard Público
PUBLIC_EXPORT_PATH=../public_dashboard/activos.json

# Hosts permitidos para CORS (separados por comas o '*' para desarrollo)
ALLOWED_HOSTS=["*"]
